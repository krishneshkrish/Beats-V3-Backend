# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Upstash Redis (TCP connection URL: rediss://...)
REDIS_URL=rediss://default:your-password@your-redis-host.upstash.io:6379

# Groq API Key (for weekly taste profiling job)
GROQ_API_KEY=gsk_your_groq_api_key

# App Configuration
PORT=8000
ENVIRONMENT=production

# CORS / Allowed Origins (Add your deployed frontend URL on Vercel/Netlify/Render, comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173,https://your-frontend.vercel.app

# Optional Scraper Proxy (for ISP-blocked environments, e.g. socks5://127.0.0.1:1080 or http://proxy:8080)
SCRAPER_PROXY=
